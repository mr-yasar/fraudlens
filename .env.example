# ==============================================================================
# Environment Configuration Template
# ==============================================================================

# Application
APP_NAME="Explainable AI Financial Fraud & Risk Detection"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Server
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Database (PostgreSQL)
# Format: postgresql+psycopg://username:password@hostname:port/database_name
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/fraud_detection_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False

# Security / JWT (For future phases)
SECRET_KEY="replace_with_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# 🤖 AI Assistant — Multi-LLM Provider API Keys (Gemini, Grok, Mistral)
# ==============================================================================
# Get Gemini key: https://aistudio.google.com/app/apikey  (Free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# Get Grok key: https://console.x.ai/  (requires xAI account with prepaid credits)
GROK_API_KEY=your_grok_api_key_here

# Get Mistral key: https://console.mistral.ai/  (Free tier available)
MISTRAL_API_KEY=your_mistral_api_key_here

# Preferred AI Engine: "gemini" | "grok" | "mistral" | "auto"
# In "auto" mode, FraudLens attempts the preferred engine and autonomously fails over
# to available configured providers (Gemini -> Mistral -> Grok) before engaging local failover.
DEFAULT_LLM_PROVIDER=gemini

