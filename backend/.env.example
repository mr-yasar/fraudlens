# Backend Environment Configuration
APP_NAME="Explainable AI Financial Fraud & Risk Detection"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Connection
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/fraud_detection_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=False

SECRET_KEY="development_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
